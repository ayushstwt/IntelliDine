# ==============================================================================
# IntelliDine Environment Configuration — DEV (Development Environment)
# ==============================================================================

# Active Spring Profile
SPRING_PROFILES_ACTIVE=dev

# ==============================================================================
# Common Infrastructure
# ==============================================================================
EUREKA_SERVER_URL=http://dev-eureka.intellidine.local:8761/eureka/
DEFAULT_ZONE=http://dev-eureka.intellidine.local:8761/eureka/
KAFKA_BOOTSTRAP_SERVERS=dev-kafka-1.intellidine.local:9092,dev-kafka-2.intellidine.local:9092

# ==============================================================================
# Service Ports
# ==============================================================================
REGISTRY_SERVICE_PORT=8761
GATEWAY_SERVICE_PORT=8765
USER_SERVICE_PORT=6060
RESTAURANT_SERVICE_PORT=9090
PAYMENT_SERVICE_PORT=9091
ORDER_SERVICE_PORT=9092
AI_SERVICE_PORT=9093

# ==============================================================================
# PostgreSQL Databases (Dev Cluster)
# ==============================================================================
DB_HOST=dev-postgres.intellidine.local
DB_USERNAME=postgres_dev
DB_PASSWORD=dev_secure_password_123

# Service Specific Connection URLs
USER_DB_URL=jdbc:postgresql://dev-postgres.intellidine.local:5432/users_db
RESTAURANT_DB_URL=jdbc:postgresql://dev-postgres.intellidine.local:5433/restaurants_db
PAYMENT_DB_URL=jdbc:postgresql://dev-postgres.intellidine.local:5434/payments_db
ORDER_DB_URL=jdbc:postgresql://dev-postgres.intellidine.local:5435/orders_db

# Connection Pool Settings
DB_POOL_MAX_SIZE=15
DB_POOL_MIN_IDLE=3
DB_POOL_IDLE_TIMEOUT=300000
DB_POOL_CONN_TIMEOUT=20000

# Hibernate & JPA Settings
SHOW_SQL=true
HIBERNATE_DDL_AUTO=update
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true

# ==============================================================================
# AI / Azure OpenAI Service Configuration
# ==============================================================================
AZURE_OPENAI_ENDPOINT=https://intellidine-dev.openai.azure.com/
AZURE_OPENAI_API_KEY=dev-azure-openai-key-abcde12345
AZURE_OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini-dev
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1000
AI_TIMEOUT_MS=30000

# ==============================================================================
# Security & JWT / RSA Keys
# ==============================================================================
RSA_PUBLIC_KEY=classpath:certs/public.pem
RSA_PRIVATE_KEY=classpath:certs/private.pem
