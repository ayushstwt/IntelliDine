# ==============================================================================
# IntelliDine Environment Configuration — PROD (Production Environment)
# ==============================================================================

# Active Spring Profile
SPRING_PROFILES_ACTIVE=prod

# ==============================================================================
# Common Infrastructure
# ==============================================================================
EUREKA_SERVER_URL=https://eureka-prod-primary.intellidine.com/eureka/,https://eureka-prod-secondary.intellidine.com/eureka/
DEFAULT_ZONE=https://eureka-prod-primary.intellidine.com/eureka/
KAFKA_BOOTSTRAP_SERVERS=prod-kafka-1.intellidine.internal:9092,prod-kafka-2.intellidine.internal:9092,prod-kafka-3.intellidine.internal:9092

# ==============================================================================
# Service Ports
# ==============================================================================
REGISTRY_SERVICE_PORT=8761
GATEWAY_SERVICE_PORT=8765
USER_SERVICE_PORT=6060
RESTAURANT_SERVICE_PORT=9090
PAYMENT_SERVICE_PORT=9091
ORDER_SERVICE_PORT=9092
AI_SERVICE_PORT=9093

# ==============================================================================
# PostgreSQL Databases (Production High-Availability Cluster with SSL)
# ==============================================================================
DB_HOST=prod-postgres-ha.intellidine.internal
DB_USERNAME=postgres_prod_app
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION_VAULT_PASSWORD

USER_DB_URL=jdbc:postgresql://prod-postgres-ha.intellidine.internal:5432/users_db?sslmode=require&sslrootcert=/etc/ssl/certs/pg-root.crt
RESTAURANT_DB_URL=jdbc:postgresql://prod-postgres-ha.intellidine.internal:5433/restaurants_db?sslmode=require&sslrootcert=/etc/ssl/certs/pg-root.crt
PAYMENT_DB_URL=jdbc:postgresql://prod-postgres-ha.intellidine.internal:5434/payments_db?sslmode=require&sslrootcert=/etc/ssl/certs/pg-root.crt
ORDER_DB_URL=jdbc:postgresql://prod-postgres-ha.intellidine.internal:5435/orders_db?sslmode=require&sslrootcert=/etc/ssl/certs/pg-root.crt

# Connection Pool Settings (HikariCP Production Tuning)
DB_POOL_MAX_SIZE=50
DB_POOL_MIN_IDLE=10
DB_POOL_IDLE_TIMEOUT=600000
DB_POOL_CONN_TIMEOUT=30000

# Hibernate & JPA Settings
SHOW_SQL=false
HIBERNATE_DDL_AUTO=validate
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true

# ==============================================================================
# AI / Azure OpenAI Service Configuration
# ==============================================================================
AZURE_OPENAI_ENDPOINT=https://intellidine-prod.openai.azure.com/
AZURE_OPENAI_API_KEY=CHANGE_ME_PRODUCTION_AZURE_OPENAI_KEY
AZURE_OPENAI_MODEL=gpt-4o
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-prod
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2000
AI_TIMEOUT_MS=60000

# ==============================================================================
# Security & JWT / RSA Keys
# ==============================================================================
RSA_PUBLIC_KEY=file:/etc/secrets/intellidine/public.pem
RSA_PRIVATE_KEY=file:/etc/secrets/intellidine/private.pem
