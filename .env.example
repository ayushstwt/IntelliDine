# ==============================================================================
# IntelliDine Environment Configuration Template (.env.example)
# Copy this file to .env or .env.<environment> (local, dev, stag, prod)
# ==============================================================================

# Active Spring Profile (local | dev | stag | prod)
SPRING_PROFILES_ACTIVE=local

# ==============================================================================
# Common Infrastructure
# ==============================================================================
EUREKA_SERVER_URL=http://localhost:8761/eureka/
DEFAULT_ZONE=http://localhost:8761/eureka/
KAFKA_BOOTSTRAP_SERVERS=localhost:19092,localhost:29092,localhost:39092

# ==============================================================================
# Service Ports
# ==============================================================================
REGISTRY_SERVICE_PORT=8761
GATEWAY_SERVICE_PORT=8765
USER_SERVICE_PORT=6060
RESTAURANT_SERVICE_PORT=9090
PAYMENT_SERVICE_PORT=9091
ORDER_SERVICE_PORT=9092
AI_SERVICE_PORT=9093

# ==============================================================================
# PostgreSQL Database Connection Variables
# ==============================================================================
DB_HOST=localhost
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword

# Individual Service Database URLs
USER_DB_URL=jdbc:postgresql://localhost:5432/users_db
RESTAURANT_DB_URL=jdbc:postgresql://localhost:5433/restaurants_db
PAYMENT_DB_URL=jdbc:postgresql://localhost:5434/payments_db
ORDER_DB_URL=jdbc:postgresql://localhost:5435/orders_db

# HikariCP Connection Pool
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_IDLE_TIMEOUT=300000
DB_POOL_CONN_TIMEOUT=20000

# JPA / Hibernate & Flyway
SHOW_SQL=true
HIBERNATE_DDL_AUTO=none
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true

# ==============================================================================
# AI / Azure OpenAI Service Configuration
# ==============================================================================
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT_NAME=<your-deployment-name>
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1000
AI_TIMEOUT_MS=30000

# ==============================================================================
# Security & JWT / RSA Keys
# ==============================================================================
RSA_PUBLIC_KEY=classpath:certs/public.pem
RSA_PRIVATE_KEY=classpath:certs/private.pem
