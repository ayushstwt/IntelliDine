# ==============================================================================
# IntelliDine Environment Configuration — LOCAL (Local Development & Testing)
# ==============================================================================

# Active Spring Profile
SPRING_PROFILES_ACTIVE=local

# ==============================================================================
# Common Infrastructure
# ==============================================================================
EUREKA_SERVER_URL=http://localhost:8761/eureka/
DEFAULT_ZONE=http://localhost:8761/eureka/
KAFKA_BOOTSTRAP_SERVERS=localhost:19092,localhost:29092,localhost:39092

# ==============================================================================
# Service Ports
# ==============================================================================
REGISTRY_SERVICE_PORT=8761
GATEWAY_SERVICE_PORT=8765
USER_SERVICE_PORT=6060
RESTAURANT_SERVICE_PORT=9090
PAYMENT_SERVICE_PORT=9091
ORDER_SERVICE_PORT=9092
AI_SERVICE_PORT=9093

# ==============================================================================
# PostgreSQL Databases (Local Docker Ports)
# ==============================================================================
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword

# User Service DB (Port 5432)
USER_DB_HOST=localhost
USER_DB_PORT=5432
USER_DB_NAME=users_db
USER_DB_URL=jdbc:postgresql://localhost:5432/users_db

# Restaurant Service DB (Port 5433)
RESTAURANT_DB_HOST=localhost
RESTAURANT_DB_PORT=5433
RESTAURANT_DB_NAME=restaurants_db
RESTAURANT_DB_URL=jdbc:postgresql://localhost:5433/restaurants_db

# Payment Service DB (Port 5434)
PAYMENT_DB_HOST=localhost
PAYMENT_DB_PORT=5434
PAYMENT_DB_NAME=payments_db
PAYMENT_DB_URL=jdbc:postgresql://localhost:5434/payments_db

# Order Service DB (Port 5435)
ORDER_DB_HOST=localhost
ORDER_DB_PORT=5435
ORDER_DB_NAME=orders_db
ORDER_DB_URL=jdbc:postgresql://localhost:5435/orders_db

# Hibernate & JPA Settings
SHOW_SQL=true
HIBERNATE_DDL_AUTO=update

# ==============================================================================
# AI / Azure OpenAI Service Configuration
# ==============================================================================
AZURE_OPENAI_ENDPOINT=https://intellidine-ai-local.openai.azure.com/
AZURE_OPENAI_API_KEY=mock-local-ai-key-12345
AZURE_OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini-local
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1000
AI_TIMEOUT_MS=30000

# ==============================================================================
# Security & JWT / RSA Keys
# ==============================================================================
RSA_PUBLIC_KEY=classpath:certs/public.pem
RSA_PRIVATE_KEY=classpath:certs/private.pem
