# ==============================================================================
# IntelliDine Environment Configuration — STAG (Staging / Pre-Production)
# ==============================================================================

# Active Spring Profile
SPRING_PROFILES_ACTIVE=stag

# ==============================================================================
# Common Infrastructure
# ==============================================================================
EUREKA_SERVER_URL=http://staging-eureka.intellidine.internal:8761/eureka/
DEFAULT_ZONE=http://staging-eureka.intellidine.internal:8761/eureka/
KAFKA_BOOTSTRAP_SERVERS=staging-kafka-1.intellidine.internal:9092,staging-kafka-2.intellidine.internal:9092

# ==============================================================================
# Service Ports
# ==============================================================================
REGISTRY_SERVICE_PORT=8761
GATEWAY_SERVICE_PORT=8765
USER_SERVICE_PORT=6060
RESTAURANT_SERVICE_PORT=9090
PAYMENT_SERVICE_PORT=9091
ORDER_SERVICE_PORT=9092
AI_SERVICE_PORT=9093

# ==============================================================================
# PostgreSQL Databases (Staging Managed Cluster with SSL)
# ==============================================================================
DB_HOST=staging-postgres.intellidine.internal
DB_USERNAME=postgres_stag
DB_PASSWORD=stag_strong_password_987

USER_DB_URL=jdbc:postgresql://staging-postgres.intellidine.internal:5432/users_db?sslmode=require
RESTAURANT_DB_URL=jdbc:postgresql://staging-postgres.intellidine.internal:5433/restaurants_db?sslmode=require
PAYMENT_DB_URL=jdbc:postgresql://staging-postgres.intellidine.internal:5434/payments_db?sslmode=require
ORDER_DB_URL=jdbc:postgresql://staging-postgres.intellidine.internal:5435/orders_db?sslmode=require

# Connection Pool Settings
DB_POOL_MAX_SIZE=25
DB_POOL_MIN_IDLE=5
DB_POOL_IDLE_TIMEOUT=600000
DB_POOL_CONN_TIMEOUT=30000

# Hibernate & JPA Settings
SHOW_SQL=false
HIBERNATE_DDL_AUTO=validate
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true

# ==============================================================================
# AI / Azure OpenAI Service Configuration
# ==============================================================================
AZURE_OPENAI_ENDPOINT=https://intellidine-staging.openai.azure.com/
AZURE_OPENAI_API_KEY=stag-azure-openai-key-99999
AZURE_OPENAI_MODEL=gpt-4o
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-staging
AI_TEMPERATURE=0.5
AI_MAX_TOKENS=1500
AI_TIMEOUT_MS=45000

# ==============================================================================
# Security & JWT / RSA Keys
# ==============================================================================
RSA_PUBLIC_KEY=file:/etc/secrets/intellidine/public.pem
RSA_PRIVATE_KEY=file:/etc/secrets/intellidine/private.pem
